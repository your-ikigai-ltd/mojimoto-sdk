{
  "name": "@mojimoto/cli",
  "version": "0.2.1",
  "description": "Command-line tool for the Mojimoto headless CMS: set up coding agents and download generated TypeScript types.",
  "author": "Your Ikigai Ltd",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-ikigai-ltd/mojimoto-sdk.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "keywords": [
    "mojimoto",
    "headless-cms",
    "cli",
    "codegen",
    "typescript"
  ],
  "bin": {
    "mojimoto": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.17.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://mojimoto.com"
}
