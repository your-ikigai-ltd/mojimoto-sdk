{
  "name": "@mojimoto/client",
  "version": "0.4.1",
  "description": "Typed client for the Mojimoto content delivery API.",
  "author": "Your Ikigai Ltd",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-ikigai-ltd/mojimoto-sdk.git",
    "directory": "packages/client"
  },
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "mojimoto",
    "headless-cms",
    "sdk",
    "client"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mojimoto/richtext": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://mojimoto.com"
}
